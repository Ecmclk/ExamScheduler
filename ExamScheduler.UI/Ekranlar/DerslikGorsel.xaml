<Window x:Class="ExamScheduler.UI.Ekranlar.DerslikGorsel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Derslik Görseli"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Bilgiler -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Derslik: " FontWeight="Bold" FontSize="18"/>
            <TextBlock x:Name="DerslikAdText" FontSize="18" Margin="5,0,20,0"/>
            <TextBlock Text="Kapasite: " FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="KapasiteText" FontSize="16" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Oturma Alanı -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OturmaAlani" HorizontalAlignment="Center" VerticalAlignment="Top" />
        </ScrollViewer>
    </Grid>
</Window>