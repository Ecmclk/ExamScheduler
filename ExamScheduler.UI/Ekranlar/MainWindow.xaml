<Window x:Class="ExamScheduler.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamScheduler.UI"
        mc:Ignorable="d"
        Title="Sınav Planlama Programı - Giriş" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Grid>
        <Border Background="White" 
                CornerRadius="15" 
                Padding="30" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Color="Gray" Opacity="0.3" BlurRadius="10"/>
            </Border.Effect>

            <StackPanel Width="270">
                <TextBlock Text="Kullanıcı Girişi" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="E-posta Adresi" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Name="EpostaTextBox" FontSize="12" Padding="7" BorderThickness="1" BorderBrush="LightGray"/>

                <TextBlock Text="Şifre" FontSize="12" FontWeight="SemiBold" Margin="0,15,0,5"/>
                <PasswordBox Name="SifrePasswordBox" FontSize="12" Padding="7" BorderThickness="1" BorderBrush="LightGray"/>

                <Button Name="GirisYapButton" Click="GirisYapButton_Click"
                        Content="Giriş Yap" FontSize="14" FontWeight="Bold" Margin="0,30,0,0"
                        Background="#007ACC" Foreground="White" Padding="8" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
