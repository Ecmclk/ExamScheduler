<UserControl x:Class="ExamScheduler.UI.Ekranlar.OturmaPlani"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExamScheduler.UI.Ekranlar"
             Width="Auto" Height="Auto">

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#10B981" BlurRadius="15" 
                                            ShadowDepth="0" Opacity="0.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button Style -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Style -->
        <Style x:Key="ModernListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Style -->
        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernListBoxItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Plan View Card Style -->
        <Style x:Key="PlanViewCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F7">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <!-- Header -->
                <Grid Margin="0,0,0,35">
                    <StackPanel>
                        <TextBlock Text="Oturma Planı 📋" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="#1F2937"/>
                        <TextBlock Text="Sınav oturma düzenlerini görüntüleyin ve dışa aktarın" 
                                   FontSize="14" 
                                   Foreground="#6B7280"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sınav Listesi Kartı -->
                    <Border Style="{StaticResource ModernCard}" Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="📅 Sınav Listesi" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1F2937"
                                       Margin="0,0,0,15"/>
                            <TextBlock Text="Oturma planını görüntülemek için bir sınav seçin" 
                                       FontSize="13" 
                                       Foreground="#6B7280"
                                       Margin="0,0,0,15"/>
                            
                            <ListBox x:Name="SinavListBox" 
                                     Style="{StaticResource ModernListBox}"
                                     MaxHeight="250"
                                     SelectionChanged="SinavListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <TextBlock Text="{Binding DersAdi}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="14"
                                                           Foreground="#1F2937"
                                                           Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="📅 " FontSize="12" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding Tarih, StringFormat=dd.MM.yyyy}" FontSize="12" Foreground="#6B7280" Margin="0,0,8,0"/>
                                                    <TextBlock Text="🕐 " FontSize="12" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding Saat}" FontSize="12" Foreground="#6B7280" Margin="0,0,8,0"/>
                                                    <TextBlock Text="🏫 " FontSize="12" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding Salonlar}" FontSize="12" Foreground="#6B7280"/>
                                                </StackPanel>



                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="1" 
                                                       Text="➜" 
                                                       FontSize="18"
                                                       Foreground="#10B981"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Oturma Planı Görselleştirme Kartı -->
                    <Border Style="{StaticResource ModernCard}" Grid.Row="1">
                        <StackPanel>
                            <TextBlock Text="🪑 Oturma Düzeni" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1F2937"
                                       Margin="0,0,0,20"/>
                            
                            <Border Style="{StaticResource PlanViewCard}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                              HorizontalScrollBarVisibility="Auto"
                                              MaxHeight="500">
                                    <StackPanel x:Name="OturmaAlani" 
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="20"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- PDF İndir Butonu -->
                    <Border Style="{StaticResource ModernCard}" Grid.Row="2">
                        <StackPanel>
                            <TextBlock Text="💾 Dışa Aktar" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1F2937"
                                       Margin="0,0,0,15"/>
                            <TextBlock Text="Oturma planını PDF formatında kaydedin" 
                                       FontSize="13" 
                                       Foreground="#6B7280"
                                       Margin="0,0,0,15"/>
                            
                            <Button x:Name="PDFIndirButton" 
                                    Content="📄 PDF Olarak İndir" 
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Click="PDFIndirButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>