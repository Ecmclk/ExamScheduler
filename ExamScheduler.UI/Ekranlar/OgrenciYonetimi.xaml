<UserControl x:Class="ExamScheduler.UI.Ekranlar.OgrenciYonetimi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ExamScheduler.UI.Ekranlar"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="950">
    <UserControl.Resources>
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Öğrenci Yönetimi" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

            <!-- Excel yükleme alanı -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Excel'den Öğrenci Listesi Yükle:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <Button Content="Excel Dosyası Seç ve Yükle" Padding="10,6" Click="ExcelYukleButton_Click"/>
            </StackPanel>

            <!-- Bölüme göre filtreleme -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Bölüme Göre Filtrele:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox x:Name="BolumFiltreComboBox" Width="250" Padding="8" VerticalContentAlignment="Center"
                          SelectionChanged="BolumFiltreComboBox_SelectionChanged"/>
                <Button x:Name="FiltreyiTemizleButton" Content="Filtreyi Temizle" Margin="10,0,0,0" Padding="10,5"
                        Click="FiltreyiTemizleButton_Click"/>
            </StackPanel>
            
            <!-- Öğrenci Arama Alanı -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Öğrenci Numarasına Göre Ara:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBox x:Name="OgrenciNoAramaTextBox" Width="200" Padding="6" VerticalContentAlignment="Center"/>
                <Button Content="Ara" Margin="10,0,0,0" Padding="10,6" Click="OgrenciAraButton_Click"/>
            </StackPanel>

            <!-- Öğrenci Detayları -->
            <TextBlock Text="Öğrenci Bilgileri" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="OgrenciBilgiTextBlock" TextWrapping="Wrap" Margin="0,0,0,15"/>
            
            

            <!-- Öğrenci listesi -->
            <TextBlock Text="Sistemdeki Öğrenciler" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
            <DataGrid x:Name="OgrencilerDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="White" BorderThickness="1" BorderBrush="#E2E8F0"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding OgrenciID}" Width="60"/>
                    <DataGridTextColumn Header="Öğrenci No" Binding="{Binding OgrenciNo}" Width="150"/>
                    <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="*"/>
                    <DataGridTextColumn Header="Bölüm" Binding="{Binding Bolum.BolumAd}" Width="*"/>
                    <DataGridTextColumn Header="Sınıf" Binding="{Binding Sinif}" Width="100"/>

                    <DataGridTemplateColumn Header="İşlemler" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sil" Background="#E53E3E" Foreground="White" FontWeight="SemiBold" Click="SilOgrenciButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
