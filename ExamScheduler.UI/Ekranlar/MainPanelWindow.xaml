<Window x:Class="ExamScheduler.UI.MainPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamScheduler.UI"
        mc:Ignorable="d"
        Title="Sınav Planlama Sistemi" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC">

    <Grid>
        <!-- Sol Menü -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2B6CB0" Grid.Column="0">
            <StackPanel>
                <TextBlock Text="Exam Scheduler"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"
                           Margin="0,20,0,40"/>

                <Button Content="Kontrol Paneli" Click="KontrolPaneliButton_Click"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Bölüm Yönetimi" Click="BolumButton_Click"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Ders Yönetimi" Click="DersButton_Click"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Öğrenci Yönetimi" Click="OgrenciButton_Click"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Kullanıcı Yönetimi" Click="KullaniciButton_Click"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Derslik Yönetimi" Click="DerslikButton_Click"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button x:Name="SinavProgramiButton" Content="Sınav Programı Oluştur" 
                        Click="SinavProgrami_Click" Visibility="Collapsed"
                        Style="{StaticResource NavButtonStyle}"/>

                <Separator Margin="10,20"/>
                <Button Content="Çıkış Yap" Click="CikisButton_Click"
                        Style="{StaticResource LogoutButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- İçerik Alanı -->
        <Border Grid.Column="1" Background="#F7FAFC" Padding="30">
            <ContentControl x:Name="MainContentControl"/>
        </Border>
    </Grid>
</Window>