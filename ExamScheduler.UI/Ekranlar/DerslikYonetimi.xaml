<UserControl x:Class="ExamScheduler.UI.Ekranlar.DerslikYonetimi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ExamScheduler.UI.Ekranlar"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="950">

    <UserControl.Resources>
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <TextBlock Text="Derslik Yönetimi" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

        <!-- Yeni Derslik Ekleme Alanı -->
        <StackPanel Orientation="Vertical" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Bölüm: " VerticalAlignment="Center" Width="100"/>
                <ComboBox x:Name="BolumComboBox" Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Derslik Kodu: " VerticalAlignment="Center" Width="100"/>
                <TextBox x:Name="DerslikKoduTextBox" Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Derslik Adı: " VerticalAlignment="Center" Width="100"/>
                <TextBox x:Name="DerslikAdTextBox" Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Kapasite: " VerticalAlignment="Center" Width="80"/>
                <TextBox x:Name="KapasiteTextBox" Width="80"/>
                <TextBlock Text="Enine Sıra: " VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBox x:Name="EnineSiraTextBox" Width="50"/>
                <TextBlock Text="Boyuna Sıra: " VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBox x:Name="BoyunaSiraTextBox" Width="50"/>
                <TextBlock Text="Sıra Yapısı: " VerticalAlignment="Center" Margin="20,0,0,0"/>
                <ComboBox x:Name="SiraYapisiComboBox" Width="50">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>
            </StackPanel>

            <Button Content="Ekle" Width="100" Margin="0,10,0,0" Click="EkleButton_Click"/>
        </StackPanel>

        <!-- Derslik Listesi -->
        <TextBlock Text="Sistemdeki Derslikler" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <DataGrid x:Name="DersliklerDataGrid" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding DerslikId}" Width="50"/>
                <DataGridTextColumn Header="Bölüm" Binding="{Binding BolumAd}" Width="150"/>
                <DataGridTextColumn Header="Kodu" Binding="{Binding DerslikKod}" Width="100"/>
                <DataGridTextColumn Header="Adı" Binding="{Binding DerslikAd}" Width="*"/>
                <DataGridTextColumn Header="Kapasite" Binding="{Binding Kapasite}" Width="80"/>
                <DataGridTextColumn Header="Enine" Binding="{Binding EnineSira}" Width="70"/>
                <DataGridTextColumn Header="Boyuna" Binding="{Binding BoyunaSira}" Width="70"/>
                <DataGridTextColumn Header="Sıra Yapısı" Binding="{Binding SiraYapisi}" Width="80"/>
                <DataGridTemplateColumn Header="İşlemler" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Sil" Background="#E53E3E" Foreground="White"
                                    Tag="{Binding DerslikId}" Click="SilButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</ScrollViewer>

    </ScrollViewer>
</UserControl>