<Window x:Class="ExamScheduler.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sınav Planlayıcı" Height="600" Width="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" VerticalAlignment="Top" HorizontalAlignment="Center">
             <!-- Excel Yükleme Butonları -->
                <Button x:Name="BtnImportCourses" Content="📘 Ders Listesi Excel Yükle" Width="250" Height="40" Margin="0,0,0,10" Click="BtnImportCourses_Click"/>
                <Button x:Name="BtnImportStudents" Content="🧑‍🎓 Öğrenci Listesi Excel Yükle" Width="250" Height="40" Margin="0,0,0,20" Click="BtnImportStudents_Click"/>

                <!-- Menü Butonları -->
                <Button x:Name="BtnShowCourses" Content="📋 Ders Listesi Menüsü" Width="250" Height="40" Margin="0,0,0,10" Click="BtnShowCourses_Click"/>
                <Button x:Name="BtnShowStudents" Content="📋 Öğrenci Listesi Menüsü" Width="250" Height="40" Margin="0,0,0,20" Click="BtnShowStudents_Click"/>
    
                <!-- Öğrenci Arama -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="TxtOgrenciNo" Width="150" Height="30" Margin="0,0,10,0"/>
                        <Button x:Name="BtnSearchStudent" Content="Ara" Width="50" Height="30" Click="BtnSearchStudent_Click"/>
                </StackPanel>
    
                <Label x:Name="LblOgrenciAdSoyad" Content="Öğrenci: " Width="350" Height="30" Margin="0,0,0,5"/>
                <ListBox x:Name="LstOgrenciDersler" Width="350" Height="150" Margin="0,0,0,20" />

                <!-- Ders Listesi -->
                <Label Content="Genel Ders Listesi:" FontWeight="Bold" Margin="0,0,0,5"/>
                <DataGrid x:Name="DataGridMain"
                          AutoGenerateColumns="True"
                          Height="250"
                          Width="550"
                          SelectionChanged="DataGridMain_SelectionChanged"/>

                <!-- Seçilen derse ait öğrenciler -->
                <Label Content="Seçilen Derse Kayıtlı Öğrenciler:" FontWeight="Bold" Margin="0,10,0,5"/>
                <DataGrid x:Name="DataGridOgrenciler"
                          AutoGenerateColumns="True"
                          Height="200"
                          Width="550"/>
        </StackPanel>
    </ScrollViewer>

     

</Window>