<Window x:Class="ExamScheduler.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Exam Scheduler - Giriş"
        Height="600" Width="950"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7">

    <Window.Resources>
        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#10B981"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#10B981"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6B7280"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4B5563"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol taraf: Logo ve sistem adı -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1F2937" Offset="0"/>
                    <GradientStop Color="#111827" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo Icon -->
                <!-- Yöntem 1: ImageBrush ile -->
                <Ellipse Width="90" Height="90" 
                         HorizontalAlignment="Center"
                         Margin="0,0,0,30">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="C:\Users\Ecem\Desktop\unnamed.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="30" 
                                          ShadowDepth="0" Opacity="0.7"/>
                    </Ellipse.Effect>
                </Ellipse>

                <TextBlock Text="KOCAELİ ÜNİVERSİTESİ"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>
                
                

                <Rectangle Height="3" Width="60" 
                           Fill="#10B981"
                           Margin="0,20,0,0"
                           RadiusX="2" RadiusY="2">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="10" 
                                        ShadowDepth="0" Opacity="0.8"/>
                    </Rectangle.Effect>
                </Rectangle>

                <TextBlock Text="Dinamik Sınav Takvimi Oluşturma Sistemi  "
                           Foreground="#6B7280"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Width="250"/>
            </StackPanel>
        </Border>

        <!-- Sağ taraf: Giriş formu -->
        <Grid Grid.Column="1">
            <Border Background="White" 
                    CornerRadius="20" 
                    Margin="40"
                    Padding="50,40">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" 
                                    ShadowDepth="0" Opacity="0.08"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Hoş Geldiniz! 👋"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,0,0,10"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Devam etmek için giriş yapın"
                               FontSize="14"
                               Margin="0,0,0,40"
                               Foreground="#6B7280"/>

                    <!-- E-posta -->
                    <TextBlock Text="E-posta Adresi" 
                               FontWeight="SemiBold" 
                               Foreground="#374151"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="EpostaTextBox" 
                             Height="45" 
                             Margin="0,0,0,20"
                             Style="{StaticResource ModernTextBox}"/>

                    <!-- Şifre -->
                    <TextBlock Text="Şifre" 
                               FontWeight="SemiBold" 
                               Foreground="#374151"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <PasswordBox x:Name="SifreBox" 
                                 Height="45" 
                                 Margin="0,0,0,30"
                                 Style="{StaticResource ModernPasswordBox}"/>

                    <!-- Giriş Butonu -->
                    <Button Content="Giriş Yap"
                            Height="50"
                            Style="{StaticResource PrimaryButton}"
                            Click="GirisButton_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#10B981" BlurRadius="15" 
                                            ShadowDepth="0" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>

                    <!-- Test Kullanıcı Butonu -->
                    <Button Content="🔧 Test Kullanıcı Ekle"
                            Height="42"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,15,0,0"
                            Click="TestUserEkleButton_Click"/>

                    <!-- Uyarı Mesajı -->
                    <Border x:Name="UyariBorder" 
                            Background="#FEE2E2" 
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,25,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="UyariText"
                                   Text=""
                                   Foreground="#DC2626"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>